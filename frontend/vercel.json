{
  "rewrites": [
    {
      "source": "/api/upload",
      "destination": "https://agrishield-backend.hostless.app/api/upload"
    },
    {
      "source": "/api/upload/:path*",
      "destination": "https://agrishield-backend.hostless.app/api/upload/:path*"
    },
    {
      "source": "/api/predict",
      "destination": "https://agrishield-backend.hostless.app/api/predict"
    },
    {
      "source": "/api/predict/:path*",
      "destination": "https://agrishield-backend.hostless.app/api/predict/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://agrishield-backend.hostless.app/uploads/:path*"
    },
    {
      "source": "/api/speech",
      "destination": "https://agrishield-worker-1.hostless.app/api/speech"
    },
    {
      "source": "/api/speech/:path*",
      "destination": "https://agrishield-worker-1.hostless.app/api/speech/:path*"
    },
    {
      "source": "/api/market",
      "destination": "https://agrishield-worker-1.hostless.app/api/market"
    },
    {
      "source": "/api/market/:path*",
      "destination": "https://agrishield-worker-1.hostless.app/api/market/:path*"
    },
    {
      "source": "/api/crop-advisor",
      "destination": "https://agrishield-worker-1.hostless.app/api/crop-advisor"
    },
    {
      "source": "/api/crop-advisor/:path*",
      "destination": "https://agrishield-worker-1.hostless.app/api/crop-advisor/:path*"
    },
    {
      "source": "/api/action-center",
      "destination": "https://agrishield-worker-1.hostless.app/api/action-center"
    },
    {
      "source": "/api/action-center/:path*",
      "destination": "https://agrishield-worker-1.hostless.app/api/action-center/:path*"
    },
    {
      "source": "/api/iot",
      "destination": "https://agrishield-worker-1.hostless.app/api/iot"
    },
    {
      "source": "/api/iot/:path*",
      "destination": "https://agrishield-worker-1.hostless.app/api/iot/:path*"
    },
    {
      "source": "/api/devices",
      "destination": "https://agrishield-worker-1.hostless.app/api/devices"
    },
    {
      "source": "/api/devices/:path*",
      "destination": "https://agrishield-worker-1.hostless.app/api/devices/:path*"
    },
    {
      "source": "/api/identify-plant",
      "destination": "https://agrishield-worker-2.hostless.app/api/identify-plant"
    },
    {
      "source": "/api/identify-plant/:path*",
      "destination": "https://agrishield-worker-2.hostless.app/api/identify-plant/:path*"
    },
    {
      "source": "/api/agrochemical-scan",
      "destination": "https://agrishield-worker-2.hostless.app/api/agrochemical-scan"
    },
    {
      "source": "/api/agrochemical/:path*",
      "destination": "https://agrishield-worker-2.hostless.app/api/agrochemical/:path*"
    },
    {
      "source": "/api/v1/agrochemical/:path*",
      "destination": "https://agrishield-worker-2.hostless.app/api/v1/agrochemical/:path*"
    },
    {
      "source": "/api/translate-plant",
      "destination": "https://agrishield-worker-2.hostless.app/api/translate-plant"
    },
    {
      "source": "/api/translate",
      "destination": "https://agrishield-worker-2.hostless.app/api/translate"
    },
    {
      "source": "/api/translate/:path*",
      "destination": "https://agrishield-worker-2.hostless.app/api/translate/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://agrishield-backend.hostless.app/api/:path*"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/onnx-wasm/:path*",
      "destination": "/onnx-wasm/:path*"
    },
    {
      "source": "/models/:path*",
      "destination": "/models/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/onnx-wasm/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
